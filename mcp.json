{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fx-agent": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${PLUGIN_ROOT}", "--frozen", "--no-dev", "fx-agent"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "HOUDINI_HOST": "127.0.0.1",
        "FXHOUDINIMCP_AUTO_LAYOUT": "0",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      }
    }
  }
}
